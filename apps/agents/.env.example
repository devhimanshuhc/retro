# An Anthropic API key (console.anthropic.com), or paste one in the web app (Connectors), which wins over this.
ANTHROPIC_API_KEY=
# 1 = with no key, run on this machine's own Claude login. Personal development only (not allowed for other users).
USE_CLAUDE_LOGIN=0
# Or run the agents on OpenAI (or paste the key in Connectors). The provider whose key was saved last is used.
OPENAI_API_KEY=

REDIS_URL=redis://localhost:6380
MONGO_URL=mongodb://localhost:27017
MONGO_DB=scheduler

# Model per agent (Claude model IDs)
ROUTER_MODEL=claude-haiku-4-5-20251001
SUPERVISOR_MODEL=claude-haiku-4-5-20251001
RESEARCH_MODEL=claude-haiku-4-5-20251001
WRITER_MODEL=claude-sonnet-5-5
CRITIC_MODEL=claude-haiku-4-5-20251001

# User-Agent for source checks. Empty = browser-like. SEC EDGAR needs "<name> <contact email>" to allow fetches.
FETCH_USER_AGENT=

# Contact email sent ONLY to services that require one from automated clients (SEC EDGAR). Use a real address you own.
CONTACT_EMAIL=

# Pause (ms) for an agent's whole queue on a 429 when the provider gives no reset time
RATE_LIMIT_PAUSE_MS=30000

# Writer <-> critic revision cap, so a picky critic can't loop forever
MAX_REVISIONS=3

# Retry pages that block plain fetches (403/429) or need JavaScript in headless Chromium (public pages only)
BROWSER_FALLBACK=1

# Token cap per run, all agents together; checked before each step (a typical run uses 200-250k)
RUN_TOKEN_BUDGET=500000

# New runs allowed per client (IP) per window, on POST /workflows
RUNS_PER_WINDOW=10
MESSAGES_PER_WINDOW=60
RUN_WINDOW_S=3600

# Comma-separated browser origins allowed to call the API
WEB_ORIGINS=http://localhost:3000

# Google Docs export. Leave empty and set it up in the app (Connectors → Google Docs → Set up), or put Retro's own
# Google app (OAuth client) here so users only click Connect. API_URL: how the browser reaches this API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_URL=http://localhost:8000
