# Retro settings. Copy to .env next to compose.yaml.

# An API key from Anthropic (console.anthropic.com) OR OpenAI (platform.openai.com); you pay per token, a run uses
# roughly 60-120k. Easier: leave both empty and paste the key in Retro's Connectors page, which checks it first.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# A real email you own. Sent ONLY to sites that require a contact (SEC filings); leave empty to skip those.
CONTACT_EMAIL=

# Google Docs export: set it up in the app (Connectors → Google Docs). Only fill these to use a Google app you made.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spending cap per run, and how many runs per hour
RUN_TOKEN_BUDGET=500000
RUNS_PER_WINDOW=10
MESSAGES_PER_WINDOW=60
RUN_WINDOW_S=3600

# Models per agent
ROUTER_MODEL=claude-haiku-4-5-20251001
SUPERVISOR_MODEL=claude-haiku-4-5-20251001
RESEARCH_MODEL=claude-haiku-4-5-20251001
WRITER_MODEL=claude-sonnet-5-5
CRITIC_MODEL=claude-haiku-4-5-20251001
